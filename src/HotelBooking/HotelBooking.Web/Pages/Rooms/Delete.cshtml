@page "{id:int}"
@model HotelBooking.Web.Pages.Rooms.DeleteModel
@{
    ViewData["Title"] = "Delete Room";
}

<h1>Delete Room</h1>

<p>Are you sure you want to delete this room?</p>
<table class="table">
    <thead>
        <tr>
            <th>Room Number</th>
            <th>Room Floor</th>
            <th>Room Category</th>
            <th>Room Is Available</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <td>@Model.Room.Number</td>
        <td>@Model.Room.Floor</td>
        <td>@Model.Room.CategoryId</td>
        <td>@Model.Room.IsAvailable</td>
    </tbody>
</table>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>